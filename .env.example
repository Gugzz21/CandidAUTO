# Banco de Dados PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=job_assistant
DB_USER=job_assistant
DB_PASSWORD=job_assistant_dev_pwd

# Servidor Backend
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Armazenamento privado de currículos
STORAGE_RESUMES_DIR=./infra/storage/resumes
MAX_UPLOAD_SIZE_MB=10

# Integração com Provedor de IA (Suporta NVIDIA NIM API / OpenAI / Gemini OpenAI-compatible)
CandidAUTO_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_TIMEOUT_SECONDS=45

# Alternativa dedicada para API NVIDIA (opcional — se preenchida, o cliente utiliza automaticamente)
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
