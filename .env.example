# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_assistant
DB_USER=job_assistant
DB_PASSWORD=change_me_in_local_env

# Servidor Backend
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Armazenamento privado de currículos
STORAGE_RESUMES_DIR=./infra/storage/resumes
MAX_UPLOAD_SIZE_MB=10

# Integração com Provedor de IA (compatível com OpenAI / Gemini OpenAI-compatible API)
LLM_PROVIDER=openai-compatible
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=45
