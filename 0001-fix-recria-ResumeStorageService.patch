+package com.jobassistant.resume.storage;
+
+import com.jobassistant.shared.BadRequestException;
+import com.jobassistant.shared.FileProcessingException;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Service;
+import org.springframework.web.multipart.MultipartFile;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Locale;
+import java.util.UUID;
+
+/**
+ * Valida (extensão, tamanho e assinatura binária) e armazena currículos em diretório privado,
+ * usando um nome interno aleatório (storage_key) que nunca expõe o nome original do arquivo.
+ */
+@Service
+public class ResumeStorageService {
+
+    private final Path baseDir;
+    private final long maxSizeBytes;
+
+    public ResumeStorageService(
+            @Value("${app.storage.resumes-dir:./infra/storage/resumes}") String resumesDir,
+            @Value("${app.storage.max-upload-size-bytes:10485760}") long maxSizeBytes
+    ) {
+        this.baseDir = Path.of(resumesDir).toAbsolutePath().normalize();
+        this.maxSizeBytes = maxSizeBytes;
+    }
+
+    public StoredResumeFile validateAndStore(MultipartFile file) {
+        if (file == null || file.isEmpty()) {
+            throw new BadRequestException("Nenhum arquivo foi enviado ou o arquivo está vazio.");
+        }
+        if (file.getSize() > maxSizeBytes) {
+            throw new BadRequestException("O arquivo excede o limite de " + (maxSizeBytes / (1024 * 1024)) + " MB.");
+        }
+
+        String original = sanitizeFilename(file.getOriginalFilename());
+        String lower = original.toLowerCase(Locale.ROOT);
+        String fileType;
+        if (lower.endsWith(".pdf")) {
+            fileType = "PDF";
+        } else if (lower.endsWith(".docx")) {
+            fileType = "DOCX";
+        } else {
+            throw new BadRequestException("Formato não suportado. Envie um arquivo PDF ou DOCX.");
+        }
+
+        byte[] content;
+        try {
+            content = file.getBytes();
+        } catch (IOException e) {
+            throw new FileProcessingException("Não foi possível ler o arquivo enviado.", e);
+        }
+        if (content.length > maxSizeBytes) {
+            throw new BadRequestException("O arquivo excede o limite de " + (maxSizeBytes / (1024 * 1024)) + " MB.");
+        }
+        if (!hasValidSignature(content, fileType)) {
+            throw new BadRequestException("O conteúdo do arquivo não corresponde ao formato " + fileType + ".");
+        }
+
+        String storageKey = UUID.randomUUID() + "." + fileType.toLowerCase(Locale.ROOT);
+        try {
+            Files.createDirectories(baseDir);
+            Path target = baseDir.resolve(storageKey).normalize();
+            if (!target.startsWith(baseDir)) {
+                throw new FileProcessingException("Caminho de armazenamento inválido.");
+            }
+            Files.write(target, content);
+        } catch (IOException e) {
+            throw new FileProcessingException("Falha ao armazenar o currículo.", e);
+        }
+
+        return new StoredResumeFile(original, storageKey, fileType, content.length, content);
+    }
+
+    private boolean hasValidSignature(byte[] c, String fileType) {
+        if ("PDF".equals(fileType)) {
+            // "%PDF-" pode ser precedido por poucos bytes de lixo, conforme tolerado por leitores de PDF.
+            int limit = Math.min(c.length - 4, 1024);
+            for (int i = 0; i < limit; i++) {
+                if (c[i] == '%' && c[i + 1] == 'P' && c[i + 2] == 'D' && c[i + 3] == 'F' && c[i + 4] == '-') {
+                    return true;
+                }
+            }
+            return false;
+        }
+        // DOCX é um ZIP: assinatura "PK\u0003\u0004"
+        return c.length > 4 && c[0] == 'P' && c[1] == 'K' && c[2] == 3 && c[3] == 4;
+    }
+
+    private String sanitizeFilename(String name) {
+        if (name == null || name.isBlank()) {
+            return "curriculo";
+        }
+        String base = name.replace('\\', '/');
+        base = base.substring(base.lastIndexOf('/') + 1).trim();
+        base = base.replaceAll("[\\p{Cntrl}]", "");
+        if (base.length() > 200) {
+            String ext = base.substring(base.lastIndexOf('.') >= 0 ? base.lastIndexOf('.') : base.length());
+            base = base.substring(0, 200 - ext.length()) + ext;
+        }
+        return base.isBlank() ? "curriculo" : base;
+    }
+
+    public record StoredResumeFile(
+            String originalFilename,
+            String storageKey,
+            String fileType,
+            long fileSizeBytes,
+            byte[] contentBytes
+    ) {
+    }
+}
